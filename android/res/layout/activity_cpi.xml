<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                style="@style/CardBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cpi_from_year" />

            <EditText
                android:id="@+id/from_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1" />

            <TextView
                style="@style/CardBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/cpi_to_year" />

            <EditText
                android:id="@+id/to_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="4"
                android:maxLines="1" />

            <Button
                android:id="@+id/calc_button"
                style="@style/DateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cpi_calc" />
        </LinearLayout>

        <TextView
            android:id="@+id/cpi_summary"
            style="@style/CardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="10dp" />

        <LinearLayout
            android:id="@+id/cpi_chart_box"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="6dp" />

        <TableLayout
            android:id="@+id/cpi_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="10dp"
            android:stretchColumns="*" />

        <TextView
            style="@style/Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/cpi_note" />
    </LinearLayout>
</ScrollView>
